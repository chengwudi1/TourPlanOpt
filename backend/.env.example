# ==============================================================
# TourPlanOpt backend configuration
#
# 高德需要【两个不同类型】的 Key，它们不能互换：
#
#   AMAP_JS_KEY   + AMAP_JS_SCODE  ->  类型选「Web端(JS API)」
#                                      前端渲染地图、POI 选点用。
#                                      JS API 2.0 必须同时配安全密钥。
#
#   AMAP_WEB_KEY                   ->  类型选「Web服务」
#                                      后端调 /v3/distance 用。
#                                      绝不能下发到浏览器。
#
# 申请：https://console.amap.com -> 应用管理 -> 创建新应用 -> 添加 Key
#       同一个应用下【分别】添加这两种类型的 Key。
#
# 域名白名单请【留空】。若绑定 localhost，之后用手机或局域网 IP 访问会
# 看到灰色地图（你自己正常、朋友不正常，极难排查）。
#
# 填错的典型症状：
#   后端报 infocode 10009 -> 把 JS API 的 Key 填进了 AMAP_WEB_KEY
#   前端报 INVALID_USER_SCODE -> AMAP_JS_SCODE 缺失或写错
# ==============================================================

# Web服务 Key（后端 REST）
AMAP_WEB_KEY=

# Web端(JS API) Key + 安全密钥（前端地图）
AMAP_JS_KEY=
AMAP_JS_SCODE=

# 一般不需要改
AMAP_JSAPI_VERSION=2.0
AMAP_BASE_URL=https://restapi.amap.com
AMAP_QPS_LIMIT=3
AMAP_TIMEOUT_S=8.0

# ==============================================================
# 对话式助手（M28）：把一句话解析成候选指令清单
#
# 只解析、不落库。确认后前端仍走既有 WebSocket op，所以这里配什么都不影响协同协议。
# 默认值是智谱的【免费】模型 GLM-4-Flash，OpenAI 兼容接口。
#
# 两条免费路线，选一条：
#
#   1) 智谱 GLM-4-Flash（要注册，不要钱）
#      https://open.bigmodel.cn -> 控制台 -> API Keys -> 新建
#      LLM_API_KEY= 填上即可，其余保持默认。
#      模型名只能填 glm-4-flash 这一个：glm-4.6-flash 对免费 key 返回 403（错误码 1220
#      「无权访问该 API」，而 /v4/models 的列表里能查到它 —— 列表不等于可调）；
#      glm-4.5-flash 是思考型，同一句话实测 56–73 秒，且 3 路并发就打回 429（1302
#      「已达到速率限制」）。
#      并发实测（免费 key，纯打上游，不带本地限流）：16 路同时发问 16/16 成功、
#      2.5–4.3 秒，中位 3.8 秒。官方文档里「并发为 1」那条说的是 4.5-flash，
#      不适用于 glm-4-flash。经后端这层压同样 8 路，先撞的是本项目的限流
#      （每个行程每分钟 10 次，见 routes_assistant.py 的 _RATE_CALLS），
#      换干净窗口的行程后 8/8 拿到 engine=llm。
#      代价在语义范围上：契约里没有「整段搬一天」这种指令，跨天移动只能落成逐地点的
#      place_move，「把周五的安排整个挪到周日」它摊成 10 条，Qwen2.5-14B-Instruct 给 4 条
#      （只搬周五真正排了东西的那几个）。多出来的都是要人一张张点掉的确认卡。
#      2026-09-18 与 3) 同题对跑（8 句 × 2 遍，两边都零退回规则）之后，本机 `.env` 用的
#      仍是 3) 那一条：同题下 14B 中位 1.3 秒、最慢 2.6 秒，这位是 2.4 秒与 16.8 秒。
#      这一路留作免费备用，换过去只改三行。
#
#   2) 本地 Ollama（连注册都不需要，也不出本机）
#      ollama pull qwen2.5:3b 之后：
#      LLM_BASE_URL=http://127.0.0.1:11434/v1
#      LLM_MODEL=qwen2.5:3b
#      LLM_API_KEY 留空即可：localhost 端点视为免鉴权。
#
#   3) 国内云（要注册，通常带免费额度）
#      以硅基流动为例，它的端点就是 OpenAI 兼容的：
#      LLM_BASE_URL=https://api.siliconflow.cn/v1
#      LLM_MODEL=Qwen/Qwen2.5-14B-Instruct   实测 1–4 秒回
#
#      这里的模型只能是「说一句答一句」的 instruct 型：一次解析是同步等的，用户正对着
#      话筒说话。带思考过程的模型（Qwen3.5 系列等）实测同一句话 90 秒不返回，等不起，
#      表现是每次都安静地退回规则解析（响应里 engine 一直是 rules）。
#
# 三条都不配也能用：助手退回内置的中文规则解析（认得「加个玄武湖玩两小时」「记得带雨伞」
# 「门票花了240」这类直白说法），后端启动日志会写明当前走的是哪条路。
#
# LLM_API_KEY 与 AMAP_WEB_KEY 同一条纪律：只在服务端用，绝不下发到浏览器。
# ==============================================================

LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TIMEOUT_S=20.0

# ==============================================================
# 语音输入（M29g）：一段录音换一行文字
#
# 只转写：录音既不落盘也不进行程，回来的那行文字仍然要人点确认卡才落地。
# ASR_BASE_URL 留空即不启用，话筒退回浏览器自带的识别 —— 而浏览器那条路的端点改不了
# （音频只发到境外那一台服务），到不了时就只剩一句「连不上识别服务」。要让话筒在任意
# 网络下都能用，就得配上下面这一节。
#
# 要求只有一条：服务提供 OpenAI 兼容的
#   POST {ASR_BASE_URL}/audio/transcriptions   multipart 字段名 file
# 并返回 {"text": "……"}。
#
# 两条免费路线，选一条：
#
#   1) 本地服务（不出本机、零成本、不需要密钥）
#      任何跑在本机、带 /v1/audio/transcriptions 的 whisper 类服务都行
#      （whisper.cpp 自带的 server 只有 /inference，要挑 OpenAI 兼容的那类）。
#      以 8100 端口为例：
#      ASR_BASE_URL=http://127.0.0.1:8100/v1
#      ASR_MODEL=whisper-1
#      ASR_API_KEY 留空即可：localhost 端点视为免鉴权。
#
#   2) 国内云的语音识别（要注册，通常带免费额度）
#      ASR_BASE_URL= 服务商给的 OpenAI 兼容基址（以 /v1 结尾）
#      ASR_API_KEY=  那把密钥
#      ASR_MODEL=    服务商的语音模型名（各家用自己的名字，不能沿用 whisper-1）
#      ASR_LANGUAGE=zh  已知只说中文时填上，能少一批同音字；留空则由服务端自判。
#
#      以硅基流动为例，两个模型都按上面这一套形状工作，转写整句中文实测一字不差：
#      ASR_BASE_URL=https://api.siliconflow.cn/v1
#      ASR_MODEL=Qwen/Qwen3-ASR-1.7B        实测 2–7 秒
#      ASR_MODEL=FunAudioLLM/SenseVoiceSmall  更省，但冷启排队实测过 48–54 秒
#      云端语音是排队实例，所以 ASR_TIMEOUT_S 要给到 60：卡在 25 秒会把闲置之后的
#      第一句话准时打成「转写服务没有应答」，而那正是用户第一次试着开口的哪一句。
#
# 后端启动日志会写明当前语音输入走的是哪条路，面板上「理解方式」里那一行「语音转写」也报
# 同一件事。ASR_API_KEY 与 AMAP_WEB_KEY / LLM_API_KEY 同一条纪律：只在服务端用，绝不
# 下发到浏览器，也不进日志。
# ==============================================================

ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=
ASR_TIMEOUT_S=60.0
# 一段录音的两个天花板：字节数与秒数。60 秒 opus 约 60 KB，2 MB 挡的是「误开十分钟录音」
# 和恶意灌包，正常说话碰不到。
ASR_MAX_BYTES=2097152
ASR_MAX_SECONDS=90
