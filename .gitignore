# --- Python / uv ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# SQLite: WAL produces -wal and -shm siblings, so ignore the whole directory,
# not just *.db
backend/data/

# --- Secrets: both Amap keys live here and must never be committed ---
.env
.env.local
.env.*.local
!.env.example
# httpx 在 INFO 级会把带 AMAP_WEB_KEY 的完整请求 URL 打进 stdout，
# 而 dev.sh / 手动起服务都会把它重定向到这个文件
.dev-backend.log

# --- Node / Vite ---
node_modules/
frontend/dist/
dist/
*.local
npm-debug.log*

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
